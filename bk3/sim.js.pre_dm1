      if (q) { G().bq = G().bq.filter((x) => x !== q); d.set(B); mood(p, 3); logT(`${p.name} finished the ${d.name.toLowerCase()}.`, 'good'); if (H.onBuilt) H.onBuilt(job.id, p); }
