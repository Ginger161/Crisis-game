    if (p.hunger >= 78 && has(p, 'food')) { take(p, 'food'); self('eat raw food'); beginAct(p, 'eat', 'table', 6, 'Eating raw food', { k: 'eat', raw: true }, { interrupt: false }); return; }
  }
