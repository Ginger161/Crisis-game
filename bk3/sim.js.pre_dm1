    if (p.fatigue <= 12 || (morning && p.fatigue <= 40) || need) { p.sleeping = false; p.act = null; if (need) logT(`${p.name} wakes, desperate for ${p.thirst >= 92 ? 'water' : 'food'}.`, 'bad'); return; }
