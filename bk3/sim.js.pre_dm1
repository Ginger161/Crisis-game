const alive = () => G().S.filter((s) => s.alive && !s.gone);
const home = () => alive().filter((s) => !s.out);
const byId = (id) => G().S.find((s) => s.id === id);
const have = (k) => H.inv(k);
function take(p, k) {                              // own pack first, then the cupboard
