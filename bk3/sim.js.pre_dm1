  if (now < a.tD) { const k = cl((now - a.t0) / Math.max(0.001, a.tD - a.t0)); return { f: a.from.f, x: a.from.x + (a.hereX - a.from.x) * cl(k * 2), up: a.from.up * (1 - k), moving: false, climbing: true, dir: 1 }; }
